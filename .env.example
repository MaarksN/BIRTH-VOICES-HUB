# General
NODE_ENV=development
PORT=3000

# Security
GEMINI_API_KEY=your_gemini_api_key

# Optional: only required if the LLM fallback chain routes to these providers
# (see lib/voice-runtime/providers/LLMGateway.ts). GEMINI_API_KEY alone is
# sufficient for the app to function — Gemini is the guaranteed fallback.
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# PostgreSQL
DATABASE_URL=postgresql://devuser:devpassword@localhost:5432/birthvoices?schema=public

# Redis / BullMQ
# Required in production — the server now fails fast at startup instead of
# silently falling back to localhost when this is unset and NODE_ENV=production.
REDIS_URL=redis://localhost:6379

# JWT and Access
JWT_SECRET=your_jwt_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret

# Comma-separated list of origins allowed to call the API / connect via Socket.IO
ALLOWED_ORIGINS=http://localhost:3000

# Voicebox (Local Zero-Cost TTS)
VOICEBOX_API_URL=http://127.0.0.1:17493

# Telephony (Twilio inbound voice)
# TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN come from the Twilio Console. PUBLIC_BASE_URL must be
# the exact public HTTPS URL registered as the Twilio number's webhook (e.g. your Cloud Run URL,
# or an ngrok tunnel for local testing) — it's used to verify the Twilio request signature.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
PUBLIC_BASE_URL=https://your-public-domain.example.com
# Optional: routes calls to a number with no Agent.phoneNumber match to this agent instead of
# hanging up — useful to get a single number working before wiring up per-number assignment.
# The agent's own tenantId is used, so no separate DEFAULT_TENANT_ID is needed.
DEFAULT_AGENT_ID=

# Telephony (Twilio outbound voice)
# Caller ID for calls placed via POST /api/voice/outbound. Must be a number you own in Twilio (or
# a verified caller ID). Without it, outbound calls are rejected with 503 instead of being placed.
TWILIO_FROM_NUMBER=

# Webhooks
# Delivery target for events whose originating call did not supply its own callbackUrl.
WEBHOOK_URL=
# HMAC-SHA256 key behind the x-birthvoices-signature header, which is how receivers prove a
# request really came from us. Unset means webhooks are sent unsigned and cannot be authenticated.
WEBHOOK_SIGNING_SECRET=

# Identidade corporativa (Keycloak / OIDC)
OIDC_ISSUER=http://localhost:8080/realms/birth-voices
OIDC_CLIENT_ID=birth-voices
OIDC_CLIENT_SECRET=

# Armazenamento compatível com S3 (MinIO no ambiente local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=birthvoices
S3_SECRET_KEY=change-this-minio-password
S3_RECORDINGS_BUCKET=birth-voice-recordings

# Antivírus ClamAV
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# OpenTelemetry Collector
OTEL_SERVICE_NAME=birth-voices-hub
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Voice AI Provider (Bland AI)
BLAND_API_KEY=sua_chave_aqui
WEBHOOK_BASE_URL=https://seu-servidor-producao.com
# Segredo compartilhado exigido no header `x-atlasgr-webhook-secret` de toda chamada a
# POST /api/webhook/atlasgr/outbound. Sem isso configurado, o webhook rejeita todas as
# requisições (falha fechada) — combine este valor com o time do AtlasGR antes de configurar em
# produção.
ATLASGR_WEBHOOK_SECRET=
# Token embutido na URL de callback que é passada à Bland AI (`/api/webhooks/bland/<token>`),
# usado para autenticar o resultado da ligação já que a API da Bland AI não suporta headers
# customizados no campo `webhook`. Sem isso configurado, nenhuma ligação é disparada nem callback
# é aceito (falha fechada).
BLAND_WEBHOOK_TOKEN=
# Janela (em segundos) durante a qual uma redelivery do mesmo webhook AtlasGR é tratada como
# duplicata e não dispara uma nova ligação. Padrão: 86400 (24h).
ATLASGR_WEBHOOK_IDEMPOTENCY_TTL_SECONDS=86400

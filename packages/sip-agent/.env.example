# Copie para .env.local (git-ignorado) e preencha. Nunca comite valores reais.

# LiveKit — do dashboard do LiveKit Cloud, ou da sua instalação self-hosted.
# LIVEKIT_URL usa esquema wss:// (não https://).
LIVEKIT_URL=wss://seu-projeto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Provedores do pipeline STT -> LLM -> TTS. São as mesmas chaves que a app principal já usa;
# reaproveite em vez de criar contas novas para a PoC.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // A PoC de SIP é um workspace isolado, com dependências próprias (LiveKit) que de propósito não
  // são instaladas na raiz. Sem esta exclusão, `npm run typecheck` — e portanto o CI — quebra em
  // imports não resolvidos de um pacote que nem entra no build da aplicação.
  "exclude": [
    "packages/sip-agent"
  ]
}